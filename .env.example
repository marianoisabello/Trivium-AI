# Base de datos (Cloud SQL Postgres via Prisma)
# Local (docker-compose.yml): postgresql://trivium:trivium@localhost:5433/trivium?schema=public
# Produccion: via Cloud SQL Auth Proxy / conector de Cloud SQL, ver checklist en PLAN.md.
DATABASE_URL=

# Firebase Auth / Identity Platform
# Local sin proyecto real: dejar FIREBASE_PROJECT_ID=demo-trivium y setear
# FIREBASE_AUTH_EMULATOR_HOST + VITE_FIREBASE_USE_EMULATOR (ver abajo) para
# usar el emulador (bunx firebase emulators:start --only auth).
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS_JSON=
FIREBASE_AUTH_EMULATOR_HOST=

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_USE_EMULATOR=

# Vertex AI (Gemini) - generacion con IA (Escenarios, Productos, Sustentabilidad)
AI_PROVIDER=vertex
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_AI_MODEL=
VERTEX_AI_LOCATION=global
AI_RATE_LIMIT_PER_HOUR=30

# Alpha Vantage - cotizaciones de mercado (unica dependencia externa no-Google
# junto con WhatsApp, ver CLAUDE.md). Sin esta key, getQuoteWithFallback
# degrada a dataSource: "manual", no rompe nada.
MARKET_DATA_API_KEY=
